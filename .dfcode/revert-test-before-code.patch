+            runtime=runtime,
+            description="执行任务",
+            prompt="finish later",
+            subagent_type="general-purpose",
+            tool_call_id="tc-concurrent",
+        )
+
+    async def other_coroutine():
+        other_task_progress.append("started")
+        await real_asyncio_sleep(0)
+        other_task_progress.append("finished")
+        sleep_gate.set()
+        return "other-done"
+
+    task_result, other_result = await asyncio.gather(run_task_tool(), other_coroutine())
+
+    assert task_result == "Task Succeeded. Result: done"
+    assert other_result == "other-done"
+    assert other_task_progress == ["started", "finished"]
