# Compose listener port exposed by nginx
PORT=2026

# PostgreSQL password used by compose services
POSTGRES_PASSWORD=change-me

# Optional in appliance mode; install.sh generates one automatically
BETTER_AUTH_SECRET=replace-with-a-long-random-secret

# Platform default model secret used when appliance setup selects the built-in model service.
# For local development you may reuse your existing OpenAI-compatible secret.
PLATFORM_MODEL_API_KEY=

# Optional: host Docker socket path for advanced Docker-outside-of-Docker sandboxing
# DEER_FLOW_DOCKER_SOCKET=/var/run/docker.sock

# Optional: override packaged skills path only for advanced installs
# DEER_FLOW_HOST_SKILLS_PATH=/app/skills

# Optional: enable LangSmith tracing for LangGraph
# LANGCHAIN_TRACING_V2=false
